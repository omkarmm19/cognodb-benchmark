# CognoDB Cloud Configuration (Free Tier c0: 0.5 vCPU, 256MB RAM, 1GB Disk)
COGNODB_URI=bolt+s://<your-instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_cognodb_password_here

# Neo4j Configuration (Aura Free or Local Docker capped at 0.5 vCPU, 512MB RAM)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=benchmark_secret_password

# Memgraph Configuration (Local Docker / Cloud capped at 0.5 vCPU, 256MB RAM)
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# FalkorDB Configuration (Local Docker / Cloud capped at 0.5 vCPU, 256MB RAM)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Benchmark Tuning Parameters
BENCHMARK_BATCH_SIZE=1000
BENCHMARK_WARMUP_RUNS=20
BENCHMARK_QUERY_RUNS=100
BENCHMARK_CONCURRENCY_LEVELS=1,10,40
