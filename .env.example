# ============================================================
# Graph Database Benchmark Suite — Environment Template
# Copy this to .env and fill in your credentials.
# NEVER commit .env to git.
# ============================================================

# ── CognoDB Cloud (c0 Free Tier) ────────────────────────────
# Signup: https://console.cognodb.com/signup
# RAM: 512 MB  |  vCPU: burst 0.5  |  Storage: 1 GiB
# Region: us-east4 (N. Virginia)
COGNODB_URI=bolt+s://<your-instance>.databases.cognodb.com
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# ── Neo4j AuraDB Free ───────────────────────────────────────
# Signup: https://neo4j.com/cloud/platform/aura-graph-database/
# Click "Start Free" → Create Instance → copy credentials shown once
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Memgraph Cloud Free ──────────────────────────────────────
# Signup: https://memgraph.com/cloud
# OR run locally: docker run -p 7688:7687 memgraph/memgraph-platform
MEMGRAPH_URI=bolt://<host>:<port>
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ── FalkorDB (local Docker) ──────────────────────────────────
# docker run -p 6379:6379 falkordb/falkordb
# Set FALKORDB_HOST=localhost after starting the container
FALKORDB_HOST=
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# ── Benchmark Parameters (optional overrides) ────────────────
# These are already set as defaults in run_benchmark.py
# BENCHMARK_WARMUP_ITERS=20
# BENCHMARK_MEASURED_ITERS=100
